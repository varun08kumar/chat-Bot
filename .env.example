# ─────────────────────────────────────────────────────────────────────────────
# LLM Observability Platform — example environment
# Copy to `.env` (git-ignored) and fill in secrets. Docker Compose reads this.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_observability
# Async DSN used by the services (host `postgres` inside the compose network).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_observability

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka ────────────────────────────────────────────────────────────────────
# Inside the compose network use kafka:9092; from the host use localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── LLM provider keys (only OpenAI is required to start) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Chat service tuning ──────────────────────────────────────────────────────
DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
