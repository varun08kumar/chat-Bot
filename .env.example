# ─────────────────────────────────────────────────────────────────────────────
# LLM Observability Platform — example environment
# Copy to `.env` (git-ignored) and fill in secrets. Docker Compose reads this.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_observability
# Async DSN used by the services (host `postgres` inside the compose network).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_observability

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Kafka ────────────────────────────────────────────────────────────────────
# Inside the compose network use kafka:9092; from the host use localhost:9094.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── LLM provider keys (set at least ONE — any one works) ───────────────────────
# Whichever key you set, make sure DEFAULT_MODEL below matches that provider
# (e.g. GROQ_API_KEY -> DEFAULT_MODEL=groq/llama-3.3-70b-versatile). Groq has
# a free tier and is the easiest to get running quickly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ── Chat service tuning ──────────────────────────────────────────────────────
DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs both JWTs (access + refresh). Generate your own — never reuse this
# across environments: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Cookies are httpOnly always, but only marked Secure (HTTPS-only) when this
# is true — leave false for plain-HTTP local dev, set true behind real TLS.
COOKIE_SECURE=false

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
